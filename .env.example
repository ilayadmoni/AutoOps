# Native Java process configuration reference. Export values explicitly in your shell/IDE.
# Spring Boot does not load .env automatically. Compose uses literal YAML values;
# this file does not replace its REPLACE placeholders. See docs/CONFIGURATION.md and docs/DEVELOPMENT.md.
# Never commit a real .env file.

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/autoops
DATABASE_USERNAME=autoops
# REQUIRED
DATABASE_PASSWORD=

# --- Authentication ---
# REQUIRED: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Access token lifetime (ms) and refresh token lifetime (ms)
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
# Native plain-HTTP development only. Keep true in production HTTPS Compose.
COOKIE_SECURE=false
# Initial administrator, created once when no administrator exists. Password: at least 10 characters, not a default.
AUTOOPS_ADMIN_USERNAME=admin
AUTOOPS_ADMIN_PASSWORD=

# --- Stored machine credentials ---
# REQUIRED: random secret (>= 16 characters) used to derive the AES-256-GCM key. Changing it makes stored passwords unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# --- AI assistant (optional; OpenRouter / OpenAI-compatible) ---
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
# Keep verification enabled; use a custom CA certificate for a TLS-inspecting proxy.
AI_SSL_VERIFY=true
# Optional PEM/DER X.509 certificate or PEM bundle at a local path readable by Java.
# In Compose use /app/certs/provider-ca.pem with the existing ./certs bind mount.
AI_SSL_CERT_PATH=

# --- Command embeddings ---
# LOCAL = offline lexical embeddings (default). OPENAI_COMPATIBLE requires the three values below (384 dimensions).
EMBEDDING_PROVIDER=LOCAL
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Object storage (MinIO or any S3-compatible service) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=autoops
# REQUIRED: at least 8 characters
MINIO_SECRET_KEY=
MINIO_BUCKET=autoops
FILES_MAX_SIZE=100MB
FILES_ORPHAN_RETENTION_DAYS=7
DATASET_MAX_SIZE=20MB

# --- Execution engine ---
# Upper bound for per-execution machine concurrency (requests choose 1..this; never above 3).
EXECUTION_MAX_CONCURRENCY=3
# Total concurrent machine jobs across all executions.
EXECUTION_WORKER_THREADS=24
EXECUTION_MAX_ACTIVE=64
EXECUTION_APPROVAL_TIMEOUT_MINUTES=1440
EXECUTION_MAX_OUTPUT_BYTES=65536

# Native server port. Leave Docker's backend at 8080 unless proxy/health checks are updated too.
SERVER_PORT=8080
